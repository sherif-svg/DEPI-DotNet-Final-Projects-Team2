@page
@model LoginModel
@{
    ViewData["Title"] = "Hospital & donor login";
}

<div class="auth-shell">
    <div class="auth-card">
        <div class="auth-card-header">
            <span class="brand-mark"><i class="bi bi-droplet-half"></i></span>
            <div>
                <p class="auth-kicker mb-1">LifePulse</p>
                <h1 class="h4 mb-0">Sign in to the matching network</h1>
            </div>
        </div>
        <div class="auth-card-body">
            <form id="account" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>
                <div class="form-floating mb-3">
                    <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                    <label asp-for="Input.Email">Email</label>
                    <span asp-validation-for="Input.Email" class="text-danger"></span>
                </div>
                <div class="form-floating mb-3">
                    <input asp-for="Input.Password" class="form-control" autocomplete="current-password" aria-required="true" placeholder="password" />
                    <label asp-for="Input.Password">Password</label>
                    <span asp-validation-for="Input.Password" class="text-danger"></span>
                </div>
                <div class="form-check mb-3">
                    <input class="form-check-input" asp-for="Input.RememberMe" />
                    <label class="form-check-label" asp-for="Input.RememberMe">Remember me</label>
                </div>
                <button type="submit" class="cta-btn cta-primary w-100 justify-content-center border-0">
                    <i class="bi bi-box-arrow-in-right"></i> Sign in
                </button>
                <p class="text-muted small mt-3 mb-0">
                    New donor?
                    <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">Create an account</a>
                </p>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
