@if (TempData["StatusMessage"] is string status)
{
    <div class="alert alert-success alert-dismissible fade show medical-alert" role="alert">
        <i class="bi bi-check-circle me-1"></i>@status
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["ErrorMessage"] is string error)
{
    <div class="alert alert-danger alert-dismissible fade show medical-alert" role="alert">
        <i class="bi bi-exclamation-triangle me-1"></i>@error
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
